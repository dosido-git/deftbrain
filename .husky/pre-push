npm run check:syntax
npm run audit
node scripts/scan-guard-keys.js

# Gate 4 — differential audit (name-keyed PF-* rules eslint doesn't cover).
# Scoped to the tool/route files this push introduces, compared against the
# remote base, so pre-existing baseline issues don't block the push.
base=$(git rev-parse --verify --quiet '@{upstream}' || git rev-parse --verify --quiet origin/main)
if [ -n "$base" ]; then
  files=$(git diff --name-only "$base"...HEAD -- 'src/tools/*.js' 'backend/routes/*.js')
  if [ -n "$files" ]; then
    echo "$files" | xargs python3 scripts/diff-audit.py --base "$base"
  fi
fi

# Gate 5 — localization audit. Verifies the fully-localized tools (the allowlist
# in scripts/localization-audit.js) stay localized: no hardcoded currency, no
# un-wrapped UI strings, and every t() key present in all supported languages.
node scripts/localization-audit.js

# Gate 6 — preamble completeness. The "In a Nutshell" card is optional by design
# (`tool?.primer &&`) and the renderer drops empty fields, so a tool with no
# preamble — or half a preamble — renders perfectly and says nothing. Exactly the
# blind spot in audit/OPPORTUNITIES.md: the capability exists and nothing reaches
# it. `edge` stays optional and is reported as a TODO, never a failure.
node scripts/primer-audit.js

# Gate 7 — sitemap lastmod state. generate-sitemap.js content-hashes each URL so
# a lastmod only moves when that page really changed; the file recording those
# hashes is only meaningful if it travels with the content it describes. It did
# not, for three weeks, and nothing said so: Railway builds from git, so every
# deploy found the state stale, re-stamped all 41 URLs with the deploy date, and
# reproduced the "everything changed today, daily" pattern the hashing exists to
# avoid. --check recomputes without writing and fails if they disagree.
node scripts/generate-sitemap.js --check

# ...and the same gate for the GUIDES sitemap, which was left out of the 2026-07
# fix and kept the bug for another three weeks. Its 18 category hubs stamped
# new Date() unconditionally on every build — 46 deploy days in 45, so all 18
# claimed to have changed that day, every day, while the 108 article URLs beside
# them carried honest article:modified_time dates. Google uses lastmod only
# while it stays "consistently and verifiably accurate", and that is a site-wide
# judgement: 11% of URLs crying wolf can cost the signal for all of them.
# Reads source only, so this needs no build.
node scripts/generate-guides-sitemap.js --check

# Gate 8 — every rename in audit/RENAMES.md has a server-side 301. Recall →
# TheCrux shipped with a CLIENT-side alias only, which a crawler never reaches:
# the server 404s first and the React redirect never runs. /Recall returned 404
# for three weeks and nothing said so, because a client-side alias looks like a
# working redirect when you click it yourself. Source-only, no build needed.
node scripts/check-renames.js
