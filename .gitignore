# Dependencies
node_modules/

# Build output (production)
build/
dist/

# Environment (NEVER commit these)
.env
.env.local
.env.production.local
.env.development.local

backend/.env

# Logs
*.log
npm-debug.log*
metrics.jsonl

# OS files
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/
*.swp
*.swo

# Claude Code local session/config
.claude/

# Testing
coverage/

priv/

# Font downloads — only the 3 working files in scripts/fonts/ are tracked
scripts/fonts/*.zip
scripts/fonts/DM_Sans,Playfair_Display/
scripts/fonts/Playfair_Display/
scripts/fonts/DM_Sans/
__pycache__/

# Excel/Word lock artifacts — created while a file is open, never content
~$*

# UX review artifacts — 131 MB of screenshots and exported PDFs. Output, not
# source: nothing in the build reads them, and git history is append-only in
# practice, so committing them would roughly double a 196 MB repo forever —
# and Railway clones it on every deploy. The findings belong in a .md; the
# 30 MB PDF of them does not.
audit/ux-review/

# Design exports — same reasoning, smaller numbers.
docs/home page redesign/
docs/*.pdf

# Per-language translation bundles, pivoted out of src/i18n/locales/tools/ by
# scripts/build-locales.js. Build artifacts: regenerated by prebuild and
# predev:frontend, so they cannot drift from the source they are built from.
src/i18n/locales/generated/

# Twemoji PNGs downloaded by scripts/generate-og.py while drawing the OG cards.
# A cache, not source: the script falls back to the jsdelivr CDN and re-saves
# anything missing, and the cards it produces (public/og/) are committed. It is
# also only ever built by hand — `npm run build:og` is not in prebuild/build/
# postbuild — so no deploy depends on these being present.
og-emoji-cache/

# Working notes and tool-rewrite critiques. Bruce's drafts, plus the .pages,
# .pdf and .png exports that come with them — input to the work, not part of
# the app. `docs/*.pdf` above only ever caught the top level; these live in
# subdirectories.
docs/tool rewrites/
docs/*.txt
docs/*.webloc
